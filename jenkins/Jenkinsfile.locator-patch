// Reference "one-click PR" job for Phase 4 - not run by this repo's own CI. Copy into
// your consumer framework's Jenkins and adjust the credential IDs / repo slug below.
//
// This is a SEPARATE, manually-triggered job, deliberately not chained onto every test
// run - a healed locator is a candidate fix, not a guaranteed one, so a human still
// reviews the PR before merging. It does not re-run the test suite itself; it pulls the
// healing-report.json already archived by jenkins/Jenkinsfile.healing-notify's test job.
//
// What it does:
//   1. Fetches target/healing-report.json from the last successful build of the
//      upstream test job (UPSTREAM_JOB param).
//   2. Runs LocatorPatchCli --apply against the chosen platform's properties file.
//   3. If that produced a real change, commits it on a fresh branch and opens a PR via
//      `gh pr create` - if nothing changed (no heals for this platform in that report),
//      the job exits cleanly with no PR.
//
// Requires:
//   - A Jenkins "Secret text" credential holding a GitHub token with repo push access,
//     bound below as GH_TOKEN (gh CLI reads GH_TOKEN automatically - no `gh auth login`
//     step needed).
//   - `gh` CLI installed on the agent.
//   - `git` configured with a bot identity (set inline below, or via global Jenkins git
//     config so every automated commit is attributable).

pipeline {
    agent any

    parameters {
        choice(name: 'PLATFORM', choices: ['android', 'ios'],
                description: 'Which locators_<platform>.properties to patch')
        string(name: 'UPSTREAM_JOB', defaultValue: 'self-healing-locators-test',
                description: 'Job whose archived healing-report.json to use (see Jenkinsfile.healing-notify)')
        string(name: 'GITHUB_REPO_SLUG', defaultValue: 'dineshbcap/self-healing-locators',
                description: 'org/repo to push the fix branch and open the PR against')
    }

    environment {
        PROPERTIES_FILE = "src/main/resources/locators/locators_${params.PLATFORM}.properties"
        BRANCH_NAME = "auto/locator-fix-${params.PLATFORM}-${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Fetch healing report') {
            steps {
                copyArtifacts(projectName: params.UPSTREAM_JOB,
                        selector: lastSuccessful(),
                        filter: 'target/healing-report.json')
            }
        }

        stage('Generate patch') {
            steps {
                sh '''
                    set -e
                    mvn -q dependency:build-classpath -Dmdep.outputFile=target/classpath.txt
                    java -cp target/classes:$(cat target/classpath.txt) \\
                        com.dinesh.healing.LocatorPatchCli \\
                        target/healing-report.json "$PROPERTIES_FILE" "$PLATFORM" --apply
                '''
            }
        }

        stage('Open PR if anything changed') {
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                    sh '''
                        set -e
                        if git diff --quiet -- "$PROPERTIES_FILE"; then
                            echo "No changes for platform '$PLATFORM' in this report - nothing to PR."
                            exit 0
                        fi

                        git config user.name "self-healing-locators-bot"
                        git config user.email "self-healing-locators-bot@users.noreply.github.com"
                        git checkout -b "$BRANCH_NAME"
                        git add "$PROPERTIES_FILE"
                        git commit -m "Auto-fix healed locator(s) in locators_${PLATFORM}.properties"
                        git push "https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPO_SLUG}.git" "$BRANCH_NAME"

                        gh pr create \\
                            --repo "$GITHUB_REPO_SLUG" \\
                            --title "Auto-fix: healed locator(s) (${PLATFORM})" \\
                            --body "Generated by \`LocatorPatchCli\` from the latest healing report (build ${UPSTREAM_JOB} #${BUILD_NUMBER}). A heal is a candidate fix, not a guaranteed one - review the diff before merging." \\
                            --base main --head "$BRANCH_NAME"
                    '''
                }
            }
        }
    }
}
